# ==============================================================================
# StrataLive — Production Environment Variables Configuration Template
# ==============================================================================
# Copy this file to .env in the stream-api/ directory:
#   cp .env.example .env
# Replace placeholder values with strong, random credentials for production.
# NEVER commit the actual .env file with secrets to version control.
# ==============================================================================

# Server Configuration
SERVER_PORT=8081

# PostgreSQL Database Configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/stream_db
SPRING_DATASOURCE_USERNAME=stream_user
SPRING_DATASOURCE_PASSWORD=replace_with_secure_db_password_here

# Redis Configuration
SPRING_DATA_REDIS_HOST=redis
SPRING_DATA_REDIS_PORT=6379

# SRS Media Server Configuration
SRS_API_URL=http://srs:1985
# Use relative '/live' so HLS streams reverse-proxy through Nginx port 80 without hardcoding IP
SRS_PLAYBACK_URL_PREFIX=/live

# MinIO Object Storage Configuration
MINIO_URL=http://minio:9000
MINIO_ROOT_USER=replace_with_secure_minio_user
MINIO_ROOT_PASSWORD=replace_with_secure_minio_password
MINIO_BUCKET_NAME=stratalive-videos

# JWT Secret Key (MUST be at least 256 bits / 32 characters of high entropy in production)
JWT_SECRET=replace_with_very_long_secure_jwt_secret_key_minimum_256_bits_length_12345

# Optional EC2 Public Host / Domain (for external direct references)
# EC2_PUBLIC_HOST=54.x.x.x
